# ============================================================
#  Modèle de configuration. Copie ce fichier en `.env` et
#  remplis les valeurs. Le `.env` n'est JAMAIS commité (gitignore).
# ============================================================

# --- MinIO (zone RAW, compatible S3) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
RAW_BUCKET=raw
STAGING_BUCKET=staging

# --- Elasticsearch (zone CURATED) ---
ES_HOST=http://localhost:9200
ES_INDEX=curated_sentiment

# --- API Hacker News (source API, aucune authentification requise) ---
# API publique Firebase : https://github.com/HackerNews/API
HN_BASE_URL=https://hacker-news.firebaseio.com/v0
HN_STORY_TYPE=topstories       # topstories | newstories | beststories
HN_MAX_ITEMS=50                # nb de posts récupérés par run d'ingestion

# --- Dataset fichier (source HuggingFace) ---
HF_DATASET=cardiffnlp/tweet_eval
HF_DATASET_CONFIG=sentiment
HF_SPLIT=train
HF_SAMPLE_SIZE=500
