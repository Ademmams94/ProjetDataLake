# ============================================================
#  Modèle de configuration. Copie ce fichier en `.env` et
#  remplis les valeurs. Le `.env` n'est JAMAIS commité (gitignore).
# ============================================================

# --- MinIO (zone RAW, compatible S3) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
RAW_BUCKET=raw
STAGING_BUCKET=staging

# --- Elasticsearch (zone CURATED) ---
ES_HOST=http://localhost:9200
ES_INDEX=curated_sentiment

# --- API Reddit (source API) ---
# Crée une app sur https://www.reddit.com/prefs/apps (type "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=datalake-projet-efrei/0.1 by u/ton_pseudo
REDDIT_SUBREDDITS=technology,france,artificial

# --- Dataset fichier (source HuggingFace) ---
HF_DATASET=tweet_eval
HF_DATASET_CONFIG=sentiment
